# Network
# Host address the Bridge port is published on. Keep 127.0.0.1 unless a client
# running in another Docker stack must reach the Bridge:
#   - Linux: 127.0.0.1 is NOT reachable from other containers through
#     host.docker.internal. Use the docker0 gateway (usually 172.17.0.1, the
#     address `host-gateway` resolves to): reachable from local containers,
#     not published on the LAN.
#   - 0.0.0.0 exposes the Bridge on every interface, LAN included: firewall it.
# Any non-loopback value requires a strong BRIDGE_API_KEY.
# See docs/chatgpt_bridge_operations.md, "Topologie".
BRIDGE_BIND_ADDRESS=127.0.0.1
BRIDGE_PORT=8001

# HTTP Bearer authentication. Required in Docker: the server listens on
# 0.0.0.0 inside its container and refuses HTTP endpoints without it.
# Client applications send it as `Authorization: Bearer <key>` under their own
# variable name.
BRIDGE_API_KEY=

# WebSocket pairing token used by the Chrome extension. Distinct from
# BRIDGE_API_KEY.
BRIDGE_WS_TOKEN=

# Runtime
BRIDGE_TOTAL_TIMEOUT=3600
BRIDGE_IDLE_TIMEOUT=300
BRIDGE_UI_TIMEOUT=30
BRIDGE_UI_PROBE_TTL=60
BRIDGE_SHUTDOWN_GRACE_SECONDS=20
