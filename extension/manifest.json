{
  "manifest_version": 3,
  "name": "ChatGPT Mini-Bridge",
  "version": "1.0.0",
  "description": "Expose l'onglet chatgpt.com comme une API locale compatible OpenAI.",
  "permissions": ["tabs", "storage", "alarms", "scripting"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": [
        "serializer.js",
        "completion.js",
        "final-output.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChatGPT Mini-Bridge"
  }
}
